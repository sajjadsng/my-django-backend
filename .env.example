# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Settings (for local development)
DB_NAME=railway
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL=

# CORS Settings
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=

# Port (Render will set this automatically)
PORT=8000

# Render will provide these values in production:
# - DATABASE_URL (PostgreSQL)
# - PORT
# - SECRET_KEY (should be set manually or let Render generate)
# - DEBUG=False
# - ALLOWED_HOSTS=.onrender.com 